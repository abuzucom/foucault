@@ -1,3 +1,20 @@
+AUTHORIZE = "https://partner.example.com/oauth/authorize"
+
+
+def begin_login(request):
+    params = {
+        "client_id": CLIENT_ID,
+        "redirect_uri": request.GET.get("return_to"),
+        "response_type": "code",
+        "scope": "profile email",
+    }
+    return redirect(AUTHORIZE + "?" + urlencode(params))
+
+
+def finish_login(request):
+    code = request.GET["code"]
+    tokens = exchange_code(code)
+    return start_session(tokens["access_token"])
