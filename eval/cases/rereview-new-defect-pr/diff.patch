 from django.db import connection
+from django.http import FileResponse
+
+from app.reports.archive import compress_report
+
+
+def export_orders(request):
+    month = request.GET.get("month", "")
+    cursor = connection.cursor()
+    cursor.execute("SELECT id, total, created_at FROM orders WHERE month = %s", (month,))
+    rows = cursor.fetchall()
+    filename = request.GET.get("filename", "orders.csv")
+    archive_path = compress_report(rows, filename)
+    return FileResponse(open(archive_path, "rb"), as_attachment=True)
