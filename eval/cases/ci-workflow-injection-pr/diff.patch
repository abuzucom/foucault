--- /dev/null
+++ b/.github/workflows/issue-triage.yml
@@ -0,0 +1,16 @@
+name: issue-triage
+on:
+  issues:
+    types: [opened]
+
+permissions: write-all
+
+jobs:
+  triage:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Log title
+        run: echo "New issue: ${{ github.event.issue.title }}"
+      - name: Apply labels
+        run: ./scripts/apply-labels.sh "${{ github.event.issue.title }}"
